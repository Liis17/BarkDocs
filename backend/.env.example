# Скопируйте в .env. Пароль попадает в URL подключения, поэтому только буквы и цифры.
POSTGRES_PASSWORD=
# Мастер-ключ администратора для HTTP API, минимум 32 символа: openssl rand -hex 32
ADMIN_KEY=
# Вход администратора в веб-консоль. Пароль от 8 символов; при каждом запуске
# barkdocs-auth он записывается заново, так забытый пароль восстанавливается.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Могут ли посетители сами создавать аккаунты в веб-консоли.
ALLOW_REGISTRATION=true
# Адрес MCP-сервера, который консоль показывает в инструкциях подключения агента.
MCP_PUBLIC_URL=http://localhost:8080/mcp
# true, если консоль открыта по HTTPS без прокси с X-Forwarded-Proto: cookie получат флаг Secure.
COOKIE_SECURE=false
# Необязательно: без токена GitHub API разрешает только 60 запросов в час.
GITHUB_TOKEN=
